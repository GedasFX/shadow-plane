{
  "name": "shadow-plane",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check && prettier --check \"src/**/*.svelte\"",
    "format": "biome check --write && prettier --write \"src/**/*.svelte\"",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
